{
  "name": "lottery-generator-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "dev:api": "wrangler dev --ip 0.0.0.0 --port 8787",
    "dev:mobile": "npm --prefix mobile start",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-all.ps1",
    "db:init:local": "wrangler d1 execute lottery-db --local --file=./migrations/init.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260405.0",
    "typescript": "^5.5.4",
    "wrangler": "^4.10.0"
  }
}
